# Copy to .env and fill in. Never commit .env.
# LLM for claim extraction + screenshot OCR only (optional; rule-based extraction without it).
# anthropic | gemini | auto (auto = whichever key is set, Anthropic first)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# tried in order when the main model is overloaded (HTTP 503/429)
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-latest

# Paths (defaults shown)
DB_PATH=db/sanad.db
CHROMA_PATH=index/chroma

# Retrieval models
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# auto | cpu | cuda | mps
DEVICE=auto
# auto (int8 ONNX on CPU if fetched, torch otherwise) | onnx | torch
MODEL_BACKEND=auto
# how many fused candidates the cross-encoder rescores (20 on GPU)
RERANK_TOP=10

# Index only core books (Bukhari, Muslim, Quran, ...) for fast setup
DEMO_SUBSET=true

# Dorar wrapper (https://github.com/AhmedElTabarani/dorar-hadith-api)
DORAR_BASE_URL=https://dorar-hadith-api.vercel.app
DORAR_OFFLINE=false

# Load models in the background at startup (first request fast)
WARM_UP=true
REQUEST_TIMEOUT_S=180

# Public deployment limits (0 = off)
RATE_VERIFY_PER_HOUR=0
RATE_LLM_PER_HOUR=0
RATE_LLM_PER_DAY_GLOBAL=0
