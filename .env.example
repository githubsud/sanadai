# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Paths (defaults shown)
DB_PATH=db/sanad.db
CHROMA_PATH=index/chroma

# Retrieval models
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# auto | cpu | cuda | mps
DEVICE=auto

# Index only core books (Bukhari, Muslim, Quran, ...) for fast setup
DEMO_SUBSET=true

# Dorar wrapper (https://github.com/AhmedElTabarani/dorar-hadith-api)
DORAR_BASE_URL=https://dorar-hadith-api.vercel.app
DORAR_OFFLINE=false
